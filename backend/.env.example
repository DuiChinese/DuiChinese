# Environment Configuration Example for DuiChinese Backend
# Copy to .env and adjust as needed

# Database Connection
# Format for PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://duichinese:duichinese_dev_pass@localhost:5432/duichinese_db

# Fallback to local SQLite if PostgreSQL service is unavailable (recommended for quick dev):
SQLITE_FALLBACK=true

# Security & CORS
SECRET_KEY=duichinese_insecure_development_secret_key_change_me
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# App Settings
APP_NAME=DuiChinese API
ENVIRONMENT=development
PORT=8000

# Supabase Auth Settings
SUPABASE_URL=https://biijwmvcpshpxgbtepws.supabase.co
# SUPABASE_JWT_SECRET=optional_standby_secret

