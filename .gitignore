# ==============================================================================
# DuiChinese - Root .gitignore
# Prevents accidental commits of secrets, local DBs, caches and dependencies
# ==============================================================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
backend/lib/
backend/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage (Python & JS)
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage/
*.lcov
.vitest/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local

# Database files & Dumps (Local development data)
*.sqlite
*.sqlite3
*.db
*.dump
*.sql
!docs/*.sql
*.pgdump
data/postgres/
postgres_data/

# Local scratch (Vite scaffolds, experiments)
tmp/

# IDEs & System files
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

